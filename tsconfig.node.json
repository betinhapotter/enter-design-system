{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "bundler", "types": ["node"],
    "composite": true, "emitDeclarationOnly": true, "declaration": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "strict": true, "skipLibCheck": true, "isolatedModules": true
  },
  "include": ["vite.config.ts"]
}
